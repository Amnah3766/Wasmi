# Copy to .env.local (and .env) and fill in. Server-only values: never commit them, never put them in client code.
# MongoDB Atlas connection string, database name "wasmi" after ".net/"
MONGODB_URI=
# Long random string used to sign the login session (JWT)
JWT_SECRET=
# Stripe TEST secret key (sk_test_… or rk_test_…). Live keys are refused.
STRIPE_SECRET_KEY=
# Optional: Stripe webhook signing secret for POST /api/stripe/webhook (bonus)
STRIPE_WEBHOOK_SECRET=
# Optional: "kwd" if your Stripe account accepts KWD; default charges USD at 1 KWD = 3.25 USD
STRIPE_CHARGE_CURRENCY=
